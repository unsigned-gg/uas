# cas-ebpfd: the CAS eBPF clamping and audit daemon (spec 0014 D8, ruling R3).
# Install: cp to /etc/systemd/system/, then systemctl daemon-reload && systemctl enable --now cas-ebpfd.
# The binary comes from `cargo build -p cas-ebpf --release -j 2` -> target/release/cas-ebpfd.
[Unit]
Description=Cerebral Agent Substrate eBPF clamping and audit daemon
Documentation=file://<home>/projects/cerebral/cas-substrate/specs/0014-ebpf-priority-clamping-and-audit-probes.md
After=local-fs.target

[Service]
Type=simple
ExecStart=/usr/local/bin/cas-ebpfd --socket /run/cas/ebpf.sock --socket-group ctodie
Restart=on-failure
RestartSec=2
User=root
Group=root
RuntimeDirectory=cas
RuntimeDirectoryMode=0755
AmbientCapabilities=CAP_BPF CAP_PERFMON CAP_SYS_NICE
CapabilityBoundingSet=CAP_BPF CAP_PERFMON CAP_SYS_NICE
NoNewPrivileges=yes
ProtectSystem=strict
ProtectHome=read-only
PrivateTmp=yes
Environment=RUST_LOG=info

[Install]
WantedBy=multi-user.target
