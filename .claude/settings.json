{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "permissions": {
    "allow": [
      "Bash(cargo *)",
      "Bash(make *)",
      "Bash(moon *)",
      "Bash(git fetch *)",
      "Bash(git rebase *)"
    ],
    "deny": [
      "Read(./docs/archive/**)"
    ]
  },
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "${CLAUDE_PROJECT_DIR}/.claude/hooks/guard-main-push.sh",
            "timeout": 5,
            "description": "Deny direct push to main/master (override: # allow-direct-push)"
          },
          {
            "type": "command",
            "command": "${CLAUDE_PROJECT_DIR}/.claude/hooks/ci-gate.sh",
            "timeout": 900,
            "description": "Run make check before a push (bypass: SKIP_CI_GATE=1)"
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "Edit|Write",
        "hooks": [
          {
            "type": "command",
            "command": "${CLAUDE_PROJECT_DIR}/.claude/hooks/lint-on-edit.sh",
            "timeout": 30,
            "description": "rustfmt an edited .rs file (advisory, never blocks)"
          }
        ]
      }
    ]
  }
}
